# Connector secrets — COPY THIS FILE to .secrets.yaml and fill in your values.
# .secrets.yaml is gitignored; this example file is committed as documentation.
#
# For CI: set DCT_CONNECTOR_<TYPE>_<FIELD> environment variables instead of this file.
# Example GitHub Secrets:
#   DCT_CONNECTOR_MYSQL_SOURCE_HOST  = r95-mys-s11.dlpxdc.co
#   DCT_CONNECTOR_MYSQL_ENV_PASSWORD = connect_123
#   DCT_CONNECTOR_MYSQL_LINK_PASSWORD = Delphix@123

mysql:
  source_host: r95-mys-s11.dlpxdc.co      # source data host (read-only, no link here)
  target_host: r95-mys-t11.dlpxdc.co      # target/staging host (link + provision here)
  env_user: mysql                           # OS user for adding environments
  env_password: REPLACE_ME
  link_user: delphix_os                    # OS user for dSource link / VDB provision
  link_password: REPLACE_ME
  # Optional overrides for schema defaults:
  # mount_path: /mnt/provision
  # staging_port: 3308
  # vdb_port: 3309

db2:
  source_host: REPLACE_ME
  target_host: REPLACE_ME
  env_user: delphix
  env_password: REPLACE_ME
  link_user: db2inst1
  link_password: REPLACE_ME
  # database: MYDB
  # port: 50000

postgresql:
  source_host: REPLACE_ME
  target_host: REPLACE_ME
  env_user: postgres
  env_password: REPLACE_ME
  link_user: postgres
  link_password: REPLACE_ME
  # database: mydb
  # port: 5432

oracle:
  source_host: REPLACE_ME
  target_host: REPLACE_ME
  env_user: delphix
  env_password: REPLACE_ME
  link_user: delphix
  link_password: REPLACE_ME
  # oracle_jdbc: //source-host:1521/ORCL

mssql:
  source_host: REPLACE_ME
  target_host: REPLACE_ME
  env_user: delphix
  env_password: REPLACE_ME
  link_user: sa
  link_password: REPLACE_ME

ase:
  source_host: REPLACE_ME
  target_host: REPLACE_ME
  env_user: delphix
  env_password: REPLACE_ME
  link_user: sa
  link_password: REPLACE_ME
